# ─── Required ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/fitxgym?sslmode=require"

# Generate: openssl rand -base64 32  (NEVER use the example value in production)
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Set true when behind Nginx, Cloudflare, Railway, Render, etc.
TRUST_PROXY=false

# Your live website URL (recommended for production)
# PUBLIC_SITE_URL=https://fitxgym.in

# Optional: only if API and website are on different domains
# ALLOWED_ORIGINS=https://fitxgym.in,https://www.fitxgym.in

# ─── First-time seed only (npm run db:seed) ───────────────────
# Owner login created on first seed — change password after first login!
SEED_OWNER1_EMAIL="owner1@fitxgym.com"
SEED_OWNER1_PASSWORD="Use-A-Strong-Password-Here"
# SEED_OWNER2_EMAIL="owner2@fitxgym.com"
# SEED_OWNER2_PASSWORD="Another-Strong-Password"

# Load sample members/payments (off by default in production)
# SEED_DEMO_DATA=false
