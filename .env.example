# ─── Required ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/fitxgym?sslmode=require"

# Generate: openssl rand -base64 32  (NEVER use the example value in production)
JWT_SECRET="change-this-to-a-long-random-secret-min-32-chars"

# ─── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# Set true when behind Nginx, Cloudflare, Railway, Render, etc.
TRUST_PROXY=false

# Your live website URL (recommended for production)
# PUBLIC_SITE_URL=https://fitxgym.in

# Optional: only if API and website are on different domains
# ALLOWED_ORIGINS=https://fitxgym.in,https://www.fitxgym.in

# ─── First-time seed only (npm run db:seed) ───────────────────
# Single owner login — use the same values as Render env vars. Extra owners are removed.
SEED_OWNER1_EMAIL="you@email.com"
SEED_OWNER1_PASSWORD="Use-A-Strong-Password-Here"
# SEED_OWNER1_NAME="Your Name"

# Load sample members/payments (off by default in production)
# SEED_DEMO_DATA=false

# ─── Password reset OTP email ─────────────────────────────────
# From address on every OTP email
OTP_FROM_EMAIL="Fit X Gym <deepaksolanki@fitxgymkhurja.com>"
# GoDaddy mailbox (preferred). Password is the email account password, not the website login.
SMTP_HOST="smtpout.secureserver.net"
SMTP_PORT="465"
SMTP_USER="deepaksolanki@fitxgymkhurja.com"
SMTP_PASS="your-mailbox-password"
# Optional instead of SMTP: Resend (verify fitxgymkhurja.com in Resend first)
# RESEND_API_KEY=""
